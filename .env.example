# AICTE Approva environment configuration
# Copy to .env and never commit the populated file.

SECRET_KEY=replace-with-a-long-random-value
API_READ_TOKEN=replace-with-read-only-adapter-token
DATABASE_PATH=instance/approva.db

# Notification engine. Leave empty to use the safe console fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aicte.gov.in

# Demo/server
DEMO_PASSWORD=AICTE@2026
SESSION_TIMEOUT_MINUTES=30
MAX_UPLOAD_MB=5
